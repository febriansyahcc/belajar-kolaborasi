# Salin file ini menjadi .env lalu isi salah satu API key.
# Tanpa API key, server berjalan dalam mode simulasi (data contoh, tanpa biaya).

# Gemini: buat API key di https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Claude: buat API key di Claude Console
ANTHROPIC_API_KEY=

# Pilih penyedia: gemini, claude, atau simulasi.
# Kosongkan untuk memilih otomatis dari API key yang terisi (Gemini didahulukan).
PROVIDER=

# Cara Manajer Gemini mencari berita:
#   rss    = judul terbaru dari Google News RSS (gratis, cocok untuk Free Tier)
#   google = Google Search grounding (Gemini 3 ke atas: hanya paket berbayar)
GEMINI_SEARCH=rss

# Model per peran untuk Gemini.
GEMINI_MODEL_MANAJER=gemini-3.8-flash
GEMINI_MODEL_EDITOR=gemini-3.8-flash
GEMINI_MODEL_PENULIS=gemini-3.8-flash
GEMINI_MODEL_RINGAN=gemini-3.8-flash

# Model per peran untuk Claude.
MODEL_MANAJER=claude-sonnet-5-5
MODEL_EDITOR=claude-sonnet-5-5
MODEL_PENULIS=claude-haiku-5-5
MODEL_RINGAN=claude-haiku-5-5

# Batas pencarian web per permintaan Manajer (khusus Claude; tiap pencarian ada biayanya).
MAX_WEB_SEARCH=5

# Paksa mode simulasi walau API key sudah diisi (1 = ya).
SIMULASI=0

PORT=3001
